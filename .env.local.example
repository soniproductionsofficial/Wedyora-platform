# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key: server-side only, NEVER exposed to the browser.
# Only set this in Vercel's Environment Variables UI, not in a file you might commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Razorpay (Settings -> API Keys) ---
# Use the TEST mode keys until KYC is approved.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin bootstrap (one-time create at /admin/login?setup=1) ---
# Long random string. Required to create the first admin email/password account.
# Set the same value in Vercel Environment Variables for production.
ADMIN_SETUP_SECRET=change-me-to-a-long-random-secret

# --- MSG91 (SMS OTP + email via Supabase Auth Hooks / Edge Functions) ---
# These are set as *Supabase Edge Function secrets*, not usually in Vercel.
# Full setup: docs/MSG91_SETUP.md
# MSG91_AUTH_KEY=
# MSG91_FLOW_ID=
# MSG91_EMAIL_DOMAIN=wedyora.com
# MSG91_EMAIL_FROM=noreply@wedyora.com
# SEND_SMS_HOOK_SECRET=
# SEND_EMAIL_HOOK_SECRET=
