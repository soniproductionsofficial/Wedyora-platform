# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000,*

# MongoDB — use "memory" for zero-setup local demos
MONGODB_URI=memory

# JWT (generate strong secrets for production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe — leave as placeholders to enable MOCK_PAYMENTS automatically
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=inr
MOCK_PAYMENTS=true

# Vendor onboarding deposit (paise for INR — ₹5,000.00)
VENDOR_DEPOSIT_AMOUNT=500000
